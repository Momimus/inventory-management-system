APP_NAME="Inventory Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production: APP_ENV=production, APP_DEBUG=false, an https:// APP_URL and the host name(s) below.
APP_TRUSTED_HOSTS=
# Behind a load balancer or platform proxy (e.g. Vercel): "*" or the proxy IP ranges. Leave empty otherwise.
APP_TRUSTED_PROXIES=

INVENTORY_CURRENCY=USD
# "public" stores product images on this server; hosts without a persistent disk (e.g. Vercel) need "s3".
PRODUCT_IMAGE_DISK=public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_management
DB_USERNAME=root
DB_PASSWORD=
# Managed MySQL over TLS: path to the CA bundle, e.g. /etc/ssl/certs/ca-certificates.crt in the Docker image.
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production over HTTPS: send the session cookie only on encrypted connections.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public base URL images are served from, and the endpoint for S3-compatible services such as Cloudflare R2.
AWS_URL=
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
